{{#if (contains (toString (toJsonString msg)) '2.16.840.1.113883.10.20.22.2.17')}}
    {{#with (getFirstCdaSectionsByTemplateId msg '2.16.840.1.113883.10.20.22.2.17')}}
        	{{#each (toArray 2_16_840_1_113883_10_20_22_2_17.entry) as |obsEntry|}}
            	{{>Resources/Observation.hbs observationCategory="social-history" observationEntry=obsEntry.observation ID=(generateUUID (toJsonString obsEntry.observation))}} 
                {{#with (evaluate 'Utils/GeneratePatientId.hbs' obj=@metriportPatientId) as |patientId|}}
					{{>References/Observation/subject.hbs ID=(generateUUID (toJsonString obsEntry.observation)) REF=(concat 'Patient/' patientId.Id)}},
				{{/with}}

                {{#each (toArray obsEntry.observation.entryRelationship) as |entryRel|}}
                    {{#if entryRel.observation}}
                        {{>Resources/Observation.hbs observationCategory="social-history" observationEntry=entryRel.observation ID=(generateUUID (toJsonString entryRel.observation))}},
                        
                        {{#with (evaluate 'Utils/GeneratePatientId.hbs' obj=@metriportPatientId) as |patientId|}}
                            {{>References/Observation/subject.hbs ID=(generateUUID (toJsonString entryRel.observation)) REF=(concat 'Patient/' patientId.Id)}},
                        {{/with}}

                        {{#each (toArray entryRel.observation.entryRelationship) as |nestedEntryRel|}}
                            {{#if nestedEntryRel.observation}}
                                {{>Resources/Observation.hbs observationCategory="social-history" observationEntry=nestedEntryRel.observation ID=(generateUUID (toJsonString nestedEntryRel.observation))}},
                                
                                {{#with (evaluate 'Utils/GeneratePatientId.hbs' obj=@metriportPatientId) as |patientId|}}
                                    {{>References/Observation/subject.hbs ID=(generateUUID (toJsonString nestedEntryRel.observation)) REF=(concat 'Patient/' patientId.Id)}},
                                {{/with}}

                                {{>Utils/ObservationAuthorPerformer.hbs authors=nestedEntryRel.observation.author observationId=(generateUUID (toJsonString nestedEntryRel.observation))}}
                            {{/if}}
                        {{/each}}
                        
                        {{>Utils/ObservationAuthorPerformer.hbs authors=entryRel.observation.author observationId=(generateUUID (toJsonString entryRel.observation))}}
                    {{/if}}
                {{/each}}

                {{>Utils/ObservationAuthorPerformer.hbs authors=obsEntry.observation.author observationId=(generateUUID (toJsonString obsEntry.observation))}}

            {{/each}}
        {{/with}}
{{/if}}