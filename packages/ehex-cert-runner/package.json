{
  "name": "@metriport/ehex-cert-runner",
  "version": "0.1.0",
  "description": "Tool to run through eHex certification test cases - by Metriport Inc.",
  "author": "Metriport Inc. <contact@metriport.com>",
  "homepage": "https://metriport.com/",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "ehex-cert-runner": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "url": "https://github.com/metriport/metriport.git",
    "type": "git",
    "directory": "packages/ehex-cert-runner"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf node_modules",
    "tsc": "tsc",
    "build": "tsc -p .",
    "build:cloud": "npm run build",
    "install-local": "npm i -g",
    "start": "ts-node src/index.ts",
    "debug": "NODE_OPTIONS='--inspect-brk' ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint . --ext .ts",
    "lint-fix": "npm run lint --fix",
    "prettier-fix": "npx prettier '**/*.{js,ts,md}' --write --ignore-path ../../.prettierignore",
    "test": "jest"
  },
  "bugs": {
    "url": "https://github.com/metriport/metriport/issues"
  },
  "dependencies": {
    "@metriport/core": "file:../core",
    "@metriport/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/jest": "29.5.3",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.3",
    "ts-jest": "29.1.1"
  }
}
